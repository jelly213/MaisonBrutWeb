---
import type { Service } from '../../data/services';

interface Props {
  id: Service['id'];
  class?: string;
}

const { id, class: className = '' } = Astro.props;
---

{/* Line art, drawn in currentColor so the badge controls the tone. */}
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    id === 'microcement' && (
      <>
        {/* Four seamless panels — the continuous surface. */}
        <rect x="3.5" y="3.5" width="17" height="17" rx="1" />
        <path d="M12 3.5v17M3.5 12h17" />
      </>
    )
  }

  {
    id === 'venetian-plaster' && (
      <>
        {/* Burnished disc: light gathering in a polished surface. */}
        <circle cx="12" cy="12" r="8" />
        <path d="M7.2 15.6a6 6 0 0 1 8.4-8.4" opacity="0.55" />
      </>
    )
  }

  {
    id === 'limewash' && (
      <>
        {/* Pigment palette. */}
        <path d="M12 3.2a8.8 8.8 0 1 0 0 17.6c.9 0 1.6-.7 1.6-1.6 0-.42-.16-.8-.42-1.08a1.6 1.6 0 0 1 1.18-2.68h1.84a4.6 4.6 0 0 0 4.6-4.6c0-4.22-4.02-7.64-8.8-7.64Z" />
        <circle cx="7.6" cy="11" r="0.9" fill="currentColor" stroke="none" />
        <circle cx="11.4" cy="7.6" r="0.9" fill="currentColor" stroke="none" />
        <circle cx="15.8" cy="10.2" r="0.9" fill="currentColor" stroke="none" />
      </>
    )
  }

  {
    id === 'furniture' && (
      <>
        {/* Bench: what we build. */}
        <path d="M5.5 11.5V8.2a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v3.3" />
        <rect x="3" y="11.5" width="18" height="5.5" rx="1.6" />
        <path d="M6.5 17v2.4M17.5 17v2.4" />
      </>
    )
  }
</svg>
