---
import type { Lang } from '../../i18n/config';
import { useTranslations, type UIKey } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const points = [1, 2, 3, 4] as const;
---

{/*
  Reassurance, not boasting. Every claim here is one the site already makes
  elsewhere — the sample step, the written timeline, the clean site, the
  two-day reply. Nothing about years in business, insurance or warranties:
  those are the client's to state, and inventing them would be worse than
  leaving them out.
*/}
<section class="mx-auto max-w-[1800px] px-6 pb-28 md:px-10 md:pb-40">
  <div class="border-t border-ink/15 pt-8">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow text-stone" data-reveal="up">{t('trust.eyebrow')}</p>
        <h2 class="display mt-5 max-w-[16ch] text-[clamp(2rem,5vw,4rem)]" data-lines>
          {t('trust.title')}
        </h2>
      </div>
      <p class="max-w-[46ch] text-sm leading-relaxed text-stone md:text-right" data-reveal="up" data-reveal-delay="0.1">
        {t('trust.lead')}
      </p>
    </div>

    <dl class="mt-16 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        points.map((point, index) => (
          <div class="border-t border-ink/10 pt-6" data-reveal="up" data-reveal-delay={(index * 0.07).toFixed(2)}>
            <span class="eyebrow text-stone/60">{String(point).padStart(2, '0')}</span>
            <dt class="mt-4 text-lg font-light leading-snug">{t(`trust.${point}.title` as UIKey)}</dt>
            <dd class="mt-3 max-w-[38ch] text-sm leading-relaxed text-stone">
              {t(`trust.${point}.text` as UIKey)}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
