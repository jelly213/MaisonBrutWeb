---
import type { Lang } from '../../i18n/config';
import { pick } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { serviceRoute } from '../../i18n/routes';
import type { Service } from '../../data/services';
import ServiceIcon from './ServiceIcon.astro';

interface Props {
  service: Service;
  lang: Lang;
  index?: number;
}

const { service, lang, index = 0 } = Astro.props;
const t = useTranslations(lang);
---

{/*
  No photograph here: the four finishes are described by an icon on a frosted
  panel — barely tinted, blurred, held together by a hairline border. Text is
  ink rather than bone, since a translucent panel over the pale page cannot
  carry light type legibly.
*/}
<a
  href={serviceRoute(service, lang)}
  class="group flex h-full flex-col items-center rounded-2xl border border-ink/10 bg-ink/[0.035] px-7 py-12 text-center text-ink backdrop-blur-xl transition-all duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1.5 hover:border-ink/25 hover:bg-ink/[0.06] md:px-9 md:py-14"
  data-reveal="up"
  data-reveal-delay={(index * 0.08).toFixed(2)}
>
  <span
    class="flex h-24 w-24 shrink-0 items-center justify-center rounded-full bg-ink text-bone transition-transform duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105 md:h-28 md:w-28"
  >
    <ServiceIcon id={service.id} class="h-11 w-11 md:h-12 md:w-12" />
  </span>

  <h3 class="mt-9 text-xl font-light tracking-tight underline decoration-ink/30 decoration-1 underline-offset-[7px] transition-colors group-hover:decoration-ink md:text-2xl">
    {pick(service.name, lang)}
  </h3>

  <p class="mt-5 max-w-[34ch] text-sm leading-relaxed text-stone">{pick(service.short, lang)}</p>

  <span class="eyebrow mt-auto pt-9 text-stone transition-colors group-hover:text-ink">
    {t('cta.discover')}
  </span>
</a>
