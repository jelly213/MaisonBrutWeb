---
import { getImage } from 'astro:assets';
import type { Lang } from '../../i18n/config';
import { pick } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { serviceRoute } from '../../i18n/routes';
import type { Service } from '../../data/services';
import AutoVideo from './AutoVideo.astro';

interface Props {
  service: Service;
  lang: Lang;
  index?: number;
}

const { service, lang, index = 0 } = Astro.props;
const t = useTranslations(lang);

// Optimise the texture at build time; fall back to the plaster panel if a
// service has no image yet.
const assets = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpeg,jpg,png,webp,avif}',
  { eager: true },
);
const asset = service.image ? assets[service.image] : undefined;
const bg = asset ? await getImage({ src: asset.default, width: 900, format: 'webp' }) : null;
---

{/*
  The texture is the card. A full-bleed background photo, an ink gradient from
  the bottom so the copy stays legible on any material, and the text laid over
  it — no icon. On hover the image drifts in scale and the veil lifts a touch.
*/}
<a
  href={serviceRoute(service, lang)}
  class="group relative flex aspect-[3/4] flex-col justify-end overflow-hidden rounded-2xl bg-plaster p-7 text-bone md:p-8"
  data-reveal="up"
  data-reveal-delay={(index * 0.08).toFixed(2)}
>
  {
    service.video ? (
      <AutoVideo
        src={service.video}
        poster={bg?.src}
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1400ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.06]"
      />
    ) : (
      bg && (
        <img
          src={bg.src}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1400ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.06]"
        />
      )
    )
  }

  {/* Legibility veil: darker at the foot, clearing toward the top. */}
  <span
    aria-hidden="true"
    class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/35 to-ink/10 transition-opacity duration-700 group-hover:from-ink/75"
  ></span>

  <div class="relative">
    <h3 class="text-2xl font-light tracking-tight md:text-[1.75rem]">{pick(service.name, lang)}</h3>
    <p class="mt-3 max-w-[32ch] text-sm leading-relaxed text-bone/85">{pick(service.short, lang)}</p>

    <span class="eyebrow mt-6 inline-flex items-center gap-2 text-bone/75 transition-colors group-hover:text-bone">
      {t('cta.discover')}
      <span aria-hidden="true" class="transition-transform duration-500 group-hover:translate-x-1">&#8594;</span>
    </span>
  </div>
</a>

