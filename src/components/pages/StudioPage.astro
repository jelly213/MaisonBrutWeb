---
import { getImage } from 'astro:assets';
import type { Lang } from '../../i18n/config';
import { otherLangs, pick } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { route } from '../../i18n/routes';
import { studio } from '../../data/studio';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../ui/Photo.astro';
import AutoVideo from '../ui/AutoVideo.astro';
import FinalCta from '../home/FinalCta.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const altPaths = otherLangs(lang).map((l) => ({ lang: l, path: route('studio', l) }));

// The still stands in as the clip's poster, so it goes through the pipeline
// even when the video is what actually plays.
const assets = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpeg,jpg,png,webp,avif}',
  { eager: true },
);
const posterAsset = assets[studio.photo.src];
const poster = posterAsset ? await getImage({ src: posterAsset.default, width: 900, format: 'webp' }) : null;
---

<BaseLayout
  lang={lang}
  title={`${t('studio.title')}: Maison Brüt`}
  description={t('meta.studio.description')}
  altPaths={altPaths}
>
  <section class="mx-auto max-w-[1800px] px-6 pb-12 pt-36 md:px-10 md:pb-20 md:pt-48">
    <p class="eyebrow text-stone">{t('studio.title')}</p>
    <h1 class="display mt-6 max-w-[18ch] text-[clamp(2.25rem,6vw,5rem)]" data-lines>{pick(studio.lead, lang)}</h1>
  </section>

  <section class="mx-auto max-w-[1800px] px-6 pb-12 pt-16 md:px-10 md:pb-16 md:pt-24">
    <div class="grid gap-16 md:grid-cols-[1.3fr_1fr] md:gap-20">
      <div class="space-y-7">
        {
          pick(studio.body, lang).map((paragraph) => (
            <p class="max-w-[62ch] leading-relaxed text-ink/85 md:text-lg" data-reveal="up">
              {paragraph}
            </p>
          ))
        }
      </div>

      {/*
        From md up the photo is taken out of flow inside a cell that stretches
        to the row. It therefore takes the text's height instead of setting a
        height of its own, and no gap opens under the shorter column.
      */}
      {/*
        Reels format: the 9:16 frame the clips are shot in, kept to a width
        that does not tower over the three paragraphs beside it.
      */}
      <div class="relative">
        {
          studio.video ? (
            <div
              class="relative mx-auto aspect-[9/16] w-full max-w-[360px] overflow-hidden rounded-2xl bg-plaster"
              data-reveal="up"
            >
              <AutoVideo
                src={studio.video}
                poster={poster?.src}
                label={pick(studio.photo.alt, lang)}
                sound
                lang={lang}
                class="h-full w-full object-cover"
              />
            </div>
          ) : (
            <Photo
              src={studio.photo.src}
              alt={pick(studio.photo.alt, lang)}
              ratio="aspect-[4/5] md:aspect-auto"
              class="w-full rounded-2xl md:absolute md:inset-0 md:h-full"
              sizes="(min-width: 768px) 38vw, 100vw"
              widths={[480, 720, 1200, 1440]}
              data-reveal="up"
            />
          )
        }
      </div>
    </div>

    <dl
      class="mt-16 grid gap-x-8 gap-y-6 border-t border-ink/15 pt-8 sm:grid-cols-2 lg:grid-cols-4"
      data-reveal="up"
    >
      {
        pick(studio.facts, lang).map((fact) => (
          <div class="border-b border-ink/10 pb-4">
            <dt class="eyebrow text-stone">{fact.label}</dt>
            <dd class="mt-2 text-sm">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* The statement closes the page, after the story it belongs to. */}
  <div class="mx-auto max-w-[1800px] px-6 pb-12 md:px-10 md:pb-20">
    <div
      class="flex flex-col justify-between gap-14 rounded-2xl bg-ink px-8 py-16 text-bone md:px-14 md:py-24"
      data-reveal="up"
    >
      <p class="display max-w-[18ch] text-[clamp(1.75rem,4.5vw,3.5rem)]">
        {pick(studio.statement, lang)}
      </p>

      <ul class="flex flex-wrap gap-x-8 gap-y-3 border-t border-bone/15 pt-8">
        {
          pick(studio.materials, lang).map((material) => (
            <li class="eyebrow text-bone/60">{material}</li>
          ))
        }
      </ul>
    </div>
  </div>

  <FinalCta lang={lang} />
</BaseLayout>
