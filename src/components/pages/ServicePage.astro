---
import type { Lang } from '../../i18n/config';
import { otherLangs, pick } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { serviceRoute, route } from '../../i18n/routes';
import { services, type Service } from '../../data/services';
import { projectsByService } from '../../data/projects';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../ui/ProjectCard.astro';
import Photo from '../ui/Photo.astro';
import FinalCta from '../home/FinalCta.astro';

interface Props {
  lang: Lang;
  service: Service;
}

const { lang, service } = Astro.props;
const t = useTranslations(lang);

const name = pick(service.name, lang);
const related = projectsByService(service.id).slice(0, 3);
const others = services.filter((item) => item.id !== service.id);
const altPaths = otherLangs(lang).map((l) => ({ lang: l, path: serviceRoute(service, l) }));
---

<BaseLayout
  lang={lang}
  title={`${name}: Maison Brüt, ${lang === 'fr' ? 'Montréal' : 'Montreal'}`}
  description={pick(service.short, lang)}
  altPaths={altPaths}
>
  <article>
    <header class="mx-auto max-w-[1800px] px-6 pb-12 pt-36 md:px-10 md:pb-20 md:pt-48">
      <a href={route('services', lang)} class="eyebrow text-stone transition-opacity hover:opacity-60">
        &#8592; {t('services.title')}
      </a>
      <h1 class="display mt-8 max-w-[14ch] text-[clamp(2.5rem,7vw,6rem)]" data-lines>{name}</h1>
      <p class="mt-8 max-w-[52ch] text-balance text-stone md:text-lg">{pick(service.short, lang)}</p>
    </header>

    {/*
      One row: the photo, then the two fact lists beside it. The source photo is
      only 736px wide, so its column stays fixed rather than stretching.
    */}
    <div
      class:list={[
        'mx-auto grid max-w-[1800px] gap-12 px-6 py-16 md:gap-16 md:px-10 md:py-20',
        service.photo ? 'md:grid-cols-[minmax(0,420px)_1fr_1fr]' : 'md:grid-cols-2',
      ]}
    >
      {
        service.photo && (
          <Photo
            src={service.photo.src}
            alt={pick(service.photo.alt, lang)}
            ratio={service.photo.ratio ?? 'aspect-[2/3]'}
            class="w-full rounded-2xl"
            sizes="(min-width: 768px) 420px, 100vw"
            widths={[480, 720, 1200]}
            data-reveal="up"
          />
        )
      }

      <div data-reveal="up">
        <h2 class="eyebrow text-stone">{t('services.uses')}</h2>
        <ul class="mt-6 space-y-3 text-sm">
          {
            pick(service.uses, lang).map((use) => (
              <li class="border-b border-ink/10 pb-3">{use}</li>
            ))
          }
        </ul>
      </div>

      <div data-reveal="up">
        <h2 class="eyebrow text-stone">{t('services.why')}</h2>
        <ul class="mt-6 space-y-3 text-sm">
          {
            pick(service.why, lang).map((reason) => (
              <li class="border-b border-ink/10 pb-3">{reason}</li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mx-auto max-w-[1800px] space-y-7 px-6 pb-16 md:px-10 md:pb-24">
      {
        pick(service.body, lang).map((paragraph) => (
          <p class="leading-relaxed text-ink/85 md:text-lg" data-reveal="up">
            {paragraph}
          </p>
        ))
      }
    </div>

    {
      related.length > 0 && (
        <section class="mx-auto max-w-[1800px] px-6 pb-20 md:px-10 md:pb-32">
          <h2 class="eyebrow border-t border-ink/15 pt-8 text-stone">{t('services.related')}</h2>
          <div class="mt-12 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((project, index) => (
              <ProjectCard project={project} lang={lang} index={index} />
            ))}
          </div>
        </section>
      )
    }

    <section class="mx-auto max-w-[1800px] px-6 pb-20 md:px-10 md:pb-32">
      <h2 class="eyebrow border-t border-ink/15 pt-8 text-stone">{t('services.other')}</h2>
      <ul class="mt-10 grid gap-x-8 gap-y-6 sm:grid-cols-3">
        {
          others.map((item) => (
            <li>
              <a
                href={serviceRoute(item, lang)}
                class="group flex items-baseline justify-between gap-4 border-b border-ink/10 pb-4 transition-colors hover:border-ink"
              >
                <span class="text-lg font-light">{pick(item.name, lang)}</span>
                <span aria-hidden="true" class="transition-transform duration-500 group-hover:translate-x-1.5">
                  &#8594;
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>

  <FinalCta lang={lang} />
</BaseLayout>
