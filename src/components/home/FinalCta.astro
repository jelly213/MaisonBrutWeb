---
import type { Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { route } from '../../i18n/routes';
import { site } from '../../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!--
  Background deepens from stone to ink as this block arrives. It never starts
  light: the text has to stay readable at every point of the transition, and
  with JS off or motion reduced the block is simply dark.
-->
<section data-final class="bg-ink text-bone">
  {/*
    Two columns on desktop so the ink block is not half empty: the invitation
    on the left, the actions held to the right on the same baseline.
  */}
  <div class="mx-auto max-w-[1800px] px-6 pb-10 md:px-10 md:pb-20">
    <div class="grid gap-8 md:grid-cols-[1.3fr_1fr] md:items-end md:gap-16">
      <h2 class="display max-w-[14ch] text-[clamp(2.5rem,7vw,6rem)]" data-lines>
        {t('home.finalTitle')}
      </h2>

      <div class="md:pb-3" data-reveal="up" data-reveal-delay="0.05">
        <p class="max-w-[42ch] text-balance text-bone/70 md:text-lg">{t('home.finalText')}</p>

        <div class="mt-7 flex flex-col gap-6 sm:flex-row sm:items-center md:mt-10">
          <a
            href={route('contact', lang)}
            class="eyebrow inline-flex items-center justify-center border border-bone bg-bone px-8 py-4 text-ink transition-colors duration-500 hover:bg-transparent hover:text-bone"
            data-magnetic
          >
            {t('cta.quote')}
          </a>
          <span class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-bone/70">
            <a href={`mailto:${site.email}`} class="transition-colors hover:text-bone">{site.email}</a>
            <span aria-hidden="true" class="text-bone/30">&#183;</span>
            <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="transition-colors hover:text-bone">
              {site.phone}
            </a>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
