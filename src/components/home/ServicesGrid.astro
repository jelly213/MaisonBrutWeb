---
import type { Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { services } from '../../data/services';
import ServiceCard from '../ui/ServiceCard.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="services" class="mx-auto max-w-[1800px] px-6 pb-20 md:px-10 md:pb-32">
  <div class="flex flex-col gap-6 border-t border-ink/15 pt-8 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="eyebrow text-stone" data-reveal="up">{t('home.servicesEyebrow')}</p>
      <h2 class="display mt-5 max-w-[16ch] text-[clamp(2rem,5vw,4rem)]" data-lines>
        {t('home.servicesTitle')}
      </h2>
    </div>
    <p class="max-w-[42ch] text-sm leading-relaxed text-stone md:text-right" data-reveal="up" data-reveal-delay="0.1">
      {t('home.servicesLead')}
    </p>
  </div>

  <div class="mt-16 grid gap-5 sm:grid-cols-2 md:gap-7 lg:grid-cols-4">
    {services.map((service, index) => <ServiceCard service={service} lang={lang} index={index} />)}
  </div>
</section>
