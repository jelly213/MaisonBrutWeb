---
import { getImage } from 'astro:assets';
import type { Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { partners } from '../../data/partners';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const assets = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpeg,jpg,png,webp,avif}',
  { eager: true },
);

const logos = await Promise.all(
  partners.map(async (partner) => {
    const asset = assets[partner.logo];
    const image = asset ? await getImage({ src: asset.default, width: 440, format: 'webp' }) : null;
    return { ...partner, src: image?.src ?? partner.logo };
  }),
);
---

{/*
  Logos arrive in four different colours on four different backgrounds. Left
  alone they would fight the page and each other, so they are desaturated and
  multiplied into the paper — white backgrounds disappear, marks stay. Colour
  and full weight come back on hover, one logo at a time.
*/}
<section class="mx-auto max-w-[1800px] px-6 pb-28 md:px-10 md:pb-40">
  <div class="border-t border-ink/15 pt-8">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow text-stone" data-reveal="up">{t('partners.eyebrow')}</p>
        <h2 class="display mt-5 max-w-[16ch] text-[clamp(2rem,5vw,4rem)]" data-lines>
          {t('partners.title')}
        </h2>
      </div>
      <p class="max-w-[44ch] text-sm leading-relaxed text-stone md:text-right" data-reveal="up" data-reveal-delay="0.1">
        {t('partners.lead')}
      </p>
    </div>

    <ul class="mt-16 grid grid-cols-2 items-center gap-x-8 gap-y-10 md:grid-cols-4 md:gap-x-12">
      {
        logos.map((partner, index) => (
          <li data-reveal="up" data-reveal-delay={(index * 0.07).toFixed(2)}>
            {partner.url ? (
              <a
                href={partner.url}
                target="_blank"
                rel="noopener noreferrer"
                class="partner-logo block"
                aria-label={partner.name}
              >
                <img src={partner.src} alt={partner.name} loading="lazy" decoding="async" width="220" height="220" />
              </a>
            ) : (
              <div class="partner-logo">
                <img src={partner.src} alt={partner.name} loading="lazy" decoding="async" width="220" height="220" />
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .partner-logo img {
    width: 100%;
    max-width: 13rem;
    height: auto;
    margin-inline: auto;
    filter: grayscale(1) contrast(1.05);
    opacity: 0.55;
    mix-blend-mode: multiply;
    transition:
      filter 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .partner-logo:hover img,
  .partner-logo:focus-visible img {
    filter: grayscale(0) contrast(1);
    opacity: 1;
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .partner-logo img {
      transition: none;
    }
  }
</style>
