---
import { getImage } from 'astro:assets';
import type { Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { partners } from '../../data/partners';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const assets = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpeg,jpg,png,webp,avif}',
  { eager: true },
);

const logos = await Promise.all(
  partners.map(async (partner) => {
    const asset = assets[partner.logo];
    const image = asset ? await getImage({ src: asset.default, width: 440, format: 'webp' }) : null;
    return { ...partner, src: image?.src ?? partner.logo };
  }),
);
---

{/*
  Logos arrive in four different colours on four different backgrounds, so
  each one keeps its own bone-toned tile even though the section itself runs
  dark.
*/}
<section class="bg-ink text-bone">
  <div class="mx-auto max-w-[1800px] px-6 py-16 md:px-10 md:py-20">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow text-bone/60" data-reveal="up">{t('partners.eyebrow')}</p>
        <h2 class="display mt-5 max-w-[16ch] text-[clamp(2rem,5vw,4rem)]" data-lines>
          {t('partners.title')}
        </h2>
      </div>
      <p class="max-w-[44ch] text-sm leading-relaxed text-bone/70 md:text-right" data-reveal="up" data-reveal-delay="0.1">
        {t('partners.lead')}
      </p>
    </div>

    <ul class="mt-16 grid grid-cols-2 items-center gap-x-6 gap-y-6 md:grid-cols-4 md:gap-x-8">
      {
        logos.map((partner, index) => (
          <li data-reveal="up" data-reveal-delay={(index * 0.07).toFixed(2)}>
            {partner.url ? (
              <a
                href={partner.url}
                target="_blank"
                rel="noopener noreferrer"
                class="partner-logo block rounded-2xl bg-bone p-6 md:p-8"
                aria-label={partner.name}
              >
                <img src={partner.src} alt={partner.name} loading="lazy" decoding="async" width="220" height="220" />
              </a>
            ) : (
              <div class="partner-logo rounded-2xl bg-bone p-6 md:p-8">
                <img src={partner.src} alt={partner.name} loading="lazy" decoding="async" width="220" height="220" />
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .partner-logo img {
    width: 100%;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
  }
</style>
