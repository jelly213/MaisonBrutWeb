---
import type { Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import Photo from '../ui/Photo.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="bg-bone pb-20 pt-8 md:pb-32 md:pt-12">
  <div class="mx-auto max-w-[1800px] px-6 md:px-10">
    <p class="eyebrow text-ink" data-reveal="up">{t('home.matterEyebrow')}</p>
    <h2 class="display mt-5 max-w-[16ch] text-[clamp(2rem,5vw,4rem)]" data-lines>
      {t('home.matterTitle')}
    </h2>
  </div>

  <div class="mx-auto mt-14 max-w-[1800px] px-6 md:px-10 lg:grid lg:grid-cols-[1fr_1.1fr] lg:items-center lg:gap-16">
    {/*
      The source photo is modest in resolution, so the frame is capped close
      to its native size instead of stretched across the section — the copy
      beside it fills the rest of the width rather than an upscaled, soft image.
    */}
    <div class="mx-auto w-full max-w-[420px] lg:mx-0">
      <Photo
        src="/src/assets/home/plaster-archway.jpg"
        alt={
          {
            en: 'Mineral plaster archway opening onto a dining room, walls and ceiling in a seamless finish',
            fr: 'Arche en plâtre minéral ouvrant sur une salle à manger, plafond et murs en finition continue',
            es: 'Arco de estuco mineral que abre a un comedor, paredes y techo en un acabado continuo',
          }[lang]
        }
        ratio="aspect-[683/1024]"
        sizes="(min-width: 1024px) 35vw, 90vw"
        data-curtain
      />
    </div>

    <div class="mt-10 space-y-5 lg:mt-0">
      <p class="max-w-[46ch] text-balance text-stone md:text-lg" data-reveal="up">{t('home.matterText')}</p>
      <p class="max-w-[46ch] text-balance text-stone md:text-lg" data-reveal="up" data-reveal-delay="0.05">
        {t('home.matterText2')}
      </p>
    </div>
  </div>
</section>
