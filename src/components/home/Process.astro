---
import type { Lang } from '../../i18n/config';
import { useTranslations, type UIKey } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = [1, 2, 3] as const;
---

<section class="bg-bone mx-auto max-w-[1800px] px-6 pb-28 md:px-10 md:pb-40">
  <div class="border-t border-ink/15 pt-8">
    <p class="eyebrow text-ink" data-reveal="up">{t('home.processEyebrow')}</p>
    <h2 class="display mt-5 max-w-[16ch] text-[clamp(2rem,5vw,4rem)]" data-lines>
      {t('home.processTitle')}
    </h2>
  </div>

  <!-- The rule is drawn by GSAP as the section scrolls past. -->
  <ol class="relative mt-16 grid gap-14 md:grid-cols-3 md:gap-10">
    <div
      data-process-line
      aria-hidden="true"
      class="absolute left-0 top-0 h-full w-px bg-ink/25 md:hidden"
    >
    </div>

    {
      steps.map((step) => (
        <li data-process-step class="relative pl-8 md:pl-0">
          <span class="eyebrow text-stone/60">{String(step).padStart(2, '0')}</span>
          <h3 class="mt-4 text-xl font-light md:text-2xl">{t(`process.${step}.title` as UIKey)}</h3>
          <p class="mt-3 max-w-[36ch] text-sm leading-relaxed text-stone">
            {t(`process.${step}.text` as UIKey)}
          </p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  /* Steps start dimmed only when GSAP is there to bring them back. */
  :global(.js) [data-process-step] {
    opacity: 0.25;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) [data-process-step] {
      opacity: 1;
    }
  }
</style>
