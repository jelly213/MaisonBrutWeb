---
import type { Lang } from '../../i18n/config';
import { languages, pick } from '../../i18n/config';
import { useTranslations, type UIKey } from '../../i18n/ui';
import { navigation, route, serviceRoute } from '../../i18n/routes';
import { services } from '../../data/services';
import { site, tagline } from '../../data/site';

interface Props {
  lang: Lang;
  altPaths: { lang: Lang; path: string }[];
}

const { lang, altPaths } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="bg-ink text-bone">
  <div class="mx-auto max-w-[1800px] px-6 pb-20 pt-8 md:px-10 md:py-28">
    <div class="grid gap-14 md:grid-cols-[1.4fr_1fr_1fr] md:gap-10">
      <div>
        <p class="display text-3xl md:text-4xl">Maison Brüt</p>
        <p class="mt-4 max-w-[34ch] text-sm leading-relaxed text-bone/60">{pick(tagline, lang)}</p>
      </div>

      <nav aria-label={t('footer.nav')}>
        <p class="eyebrow text-bone/40">{t('footer.nav')}</p>
        <ul class="mt-5 space-y-2.5 text-sm">
          {
            navigation.map(({ key, label }) => (
              <li>
                <a href={route(key, lang)} class="transition-opacity hover:opacity-60">
                  {t(label as UIKey)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="eyebrow text-bone/40">{t('footer.contact')}</p>
        <ul class="mt-5 space-y-2.5 text-sm">
          <li>
            <a href={`mailto:${site.email}`} class="transition-opacity hover:opacity-60">{site.email}</a>
          </li>
          <li>
            <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="transition-opacity hover:opacity-60">
              {site.phone}
            </a>
          </li>
          <li>
            <a href={site.instagram} rel="noopener noreferrer" target="_blank" class="transition-opacity hover:opacity-60">
              {t('contact.instagram')}
            </a>
          </li>
          <li class="pt-2 text-bone/50">{t('contact.serving')}</li>
        </ul>

        <p class="eyebrow mt-8 text-bone/40">{t('services.title')}</p>
        <ul class="mt-5 space-y-2.5 text-sm">
          {
            services.map((service) => (
              <li>
                <a href={serviceRoute(service, lang)} class="transition-opacity hover:opacity-60">
                  {pick(service.name, lang)}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-20 flex flex-col gap-4 border-t border-bone/15 pt-8 text-xs text-bone/45 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Maison Brüt. {t('footer.rights')}</p>
      <span class="flex items-center gap-3">
        {
          altPaths.map((alt, index) => (
            <>
              {index > 0 && <span class="text-bone/30" aria-hidden="true">·</span>}
              <a href={alt.path} hreflang={alt.lang} class="eyebrow text-bone/60 transition-opacity hover:opacity-100">
                {languages[alt.lang]}
              </a>
            </>
          ))
        }
      </span>
    </div>
  </div>
</footer>
