---
import '@fontsource-variable/inter';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import type { Lang } from '../i18n/config';
import { defaultLang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { site } from '../data/site';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Same page in every other language — powers the switcher and hreflang. */
  altPaths: { lang: Lang; path: string }[];
  /** True on pages whose hero runs under a transparent header. */
  overHero?: boolean;
}

const { lang, title, description, altPaths, overHero = false } = Astro.props;
const t = useTranslations(lang);

const canonical = new URL(Astro.url.pathname, Astro.site);
const defaultPath = lang === defaultLang ? Astro.url.pathname : altPaths.find((alt) => alt.lang === defaultLang)?.path;

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  description,
  email: site.email,
  telephone: site.phone,
  url: Astro.site?.toString(),
  image: canonical.toString(),
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  areaServed: site.areaServed.map((name) => ({ '@type': 'City', name })),
  sameAs: [site.instagram],
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    {altPaths.map((alt) => <link rel="alternate" hreflang={alt.lang} href={new URL(alt.path, Astro.site)} />)}
    {defaultPath && <link rel="alternate" hreflang="x-default" href={new URL(defaultPath, Astro.site)} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={{ en: 'en_CA', fr: 'fr_CA', es: 'es_ES' }[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* TODO: add /og.jpg (1200×630) once the client's photos are in. */}

    <script is:inline set:html={JSON.stringify(businessSchema)} type="application/ld+json" />

    {/* Marks that scripting is available, so reveal styles never strand content. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <!-- Page-specific head content, e.g. FAQ structured data. -->
    <slot name="head" />

    <ClientRouter />
  </head>

  <body>
    <a
      href="#main"
      class="eyebrow sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-ink focus:px-4 focus:py-3 focus:text-bone"
    >
      {t('nav.skip')}
    </a>

    <Header lang={lang} altPaths={altPaths} overHero={overHero} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} altPaths={altPaths} />

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
